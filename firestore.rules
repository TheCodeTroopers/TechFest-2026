rules_version = '2';

// The browser never talks to Firestore directly in this app: sign-in happens
// with Firebase Auth, and every read and write goes through a Next.js route
// using the Admin SDK (which bypasses these rules). So the safest rule set is
// to close the client SDK off completely.
//
// If you later move reads or writes into the browser, swap in the commented
// block below instead of deleting this one wholesale.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

